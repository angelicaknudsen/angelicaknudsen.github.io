  <link rel="icon" type='image/x-icon' href="/images/favicon.ico">

  <link rel="stylesheet" href="/bundle.css">

  <script>
        MathJax = {
          tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']]
          }
        };
  </script>
  <script id="MathJax-script" async
          src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js">
  </script>
</head>
<body>
    <header>
        <div class="topnav" id="tn">
            <div class="billy">
                <a class = 'name' href="/" tabindex = "0">
                    <img src="/images/billy.png" title="Hi! I'm Billy, a rock pigeon." height=50px width=60px class='img-fluid' alt="billy">
                </a>
            </div>

            <div class="dropdown-menu" id="dropdown-menu-id">
                <button class="expand-menu" aria-label="expand-menu" id="expand-menu" aria-expanded="false">
                    <div class="hamburgerbutton" id="hamburgerbutton">
                    Menu
                    <div class="hblinecontainer">
                        <div class="hbline">
                        </div>
                        <div class="hbline">
                        </div>
                        <div class="hbline">
                        </div>
                    </div>
                </div>
                </button>

                <nav class="menusublinkswrapper" id="menusublinkswrapper" aria-label="Main">
                    <ul class="menusublinks" id="menusublinks">
                        <li>
                            <a href="/">Home</a>
                        </li>
                        <li>
                            <a href="/resume/">Resume</a>
                        </li>
                        <li>
                            <a href="/projects/">Projects</a>
                        </li>
                        <li>
                            <a href="/blog/">Blog</a>
                        </li>
                        <li>
                            <a href="/birds/">Birds</a>
                        </li>
                        <li>
                            <a href="/hobbies/">Hobbies</a>
                        </li>
                    </ul>
                </nav>
                
            </div>
        </div>
    </header>
  

  <!-- -->
  <main class="content">

    <div class="main container">
      {{ content | safe }}
    </div>

    <div class='back-to-top'>
       <a href="#" onclick="document.body.scrollTop=0;document.documentElement.scrollTop=0;event.preventDefault()">
            ↑ Back to top
        </a>
    </div>
</main>

  <footer class="bottomnav">
        <div class="contact-links">
            <a href="mailto:angelica.knudsen05@gmail.com" title="Email">
                <div class="email-logo">
                    <img src="/images/email-icon.svg" alt="email-icon">
                </div>
            </a>
            <a href="https://www.linkedin.com/in/angelicaknudsen/" title="Linkedin">
                <div>
                    <img src="/images/linkedin.svg" alt="linkedin-icon">
                </div>
            </a>
            <a href="https://github.com/angelicaknudsen" title="GitHub">
                <div>
                    <img src="/images/github_logo.svg" alt="github-icon">
                </div>
            </a>
        </div>

        <div class="copyright">
            <p>
                &copy; Angelica Knudsen 2026
            </p>
        </div>
    </footer>

    <div>
        <a href="#" onclick="document.body.scrollTop=0;document.documentElement.scrollTop=0;event.preventDefault()">
            <div class='scrollTopBottom' id='scrollTopBottom'>
                <div>
                    ➜
                </div>
            </div>
        </a>
    </div>

    <script>
        let timerState = -1;
        window.addEventListener('scroll', function() {
            const s = document.getElementById('scrollTopBottom') 
            clearTimeout(timerState)
            console.log(window.scrollY)
            if (window.scrollY > 300) {
                s.style.display = 'unset';
                s.style.opacity = '1';
            } else {
                s.style.display = 'unset';
                s.style.opacity = '0';
                timerState = setTimeout(function(){
                    s.style.display = 'none';
                },500)
            }
        });
    </script>

    <script src="/script.js"></script>
</body>
</html>